rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // REMPLACEZ par l'e-mail de l'administrateur (téléphone 1)
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email in ['admin@exemple.com'];
    }

    // REMPLACEZ par les e-mails de l'administrateur ET de l'utilisateur (téléphone 2)
    function isMember() {
      return request.auth != null
        && request.auth.token.email in ['admin@exemple.com', 'utilisateur@exemple.com'];
    }

    match /{document=**} {
      allow read:  if isMember();   // admin + utilisateur peuvent consulter
      allow write: if isAdmin();    // seul l'admin peut ajouter, modifier, supprimer
    }
  }
}
